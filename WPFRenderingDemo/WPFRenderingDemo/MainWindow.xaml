<tianxia:BlurWindow x:Class="WPFRenderingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFRenderingDemo"
        xmlns:tianxia="clr-namespace:TianXiaTech;assembly=BlurWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Closing="Window_Closing">
    <tianxia:BlurWindow.Background>
        <SolidColorBrush Color="White" Opacity=".6"></SolidColorBrush>
    </tianxia:BlurWindow.Background>
    <Grid>
        <Button Content="打开绘制窗口" HorizontalAlignment="Center" VerticalAlignment="Center" Width="88" Height="28" Click="Button_Click" Margin="0,0,120,0"></Button>
        <Button Content="关闭绘制窗口" HorizontalAlignment="Center" VerticalAlignment="Center" Width="88" Height="28" Click="Button_Click_1" Margin="120,0,0,0"></Button>
    </Grid>
</tianxia:BlurWindow>
