<tianxia:BlurWindow x:Class="DisplayFPS.MainWindow"
        xmlns:tianxia="clr-namespace:TianXiaTech;assembly=BlurWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DisplayFPS"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <SolidColorBrush Color="Black" Opacity=".75"></SolidColorBrush>
    </Window.Background>
    <Grid>
        <StackPanel>
            <!--消耗的时间-->
            <Label HorizontalAlignment="Right" VerticalAlignment="Top" Name="myStopwatchLabel" Foreground="White"></Label>
            <!--渲染的总帧数-->
            <Label HorizontalAlignment="Right" VerticalAlignment="Top" Name="myFrameCounterLabel" Foreground="White"></Label>
            <!--fps-->
            <Label HorizontalAlignment="Right" VerticalAlignment="Top" Name="myFrameRateLabel" Foreground="White"></Label>
        </StackPanel>
    </Grid>
</tianxia:BlurWindow>
